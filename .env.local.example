# Copy this file to .env.local and fill in all keys.
# .env.local is gitignored — never commit actual keys.

# ── Anthropic (coaching + call analysis) ───────────────────────────────────────
# Get a key at: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Turso (libSQL) — whole-hub RAG ─────────────────────────────────────────────
# Optional. Without these keys, coaching stays in basic (single-card) mode.
# Turso Cloud: https://turso.tech (libsql:// URL; API converts to https://)
# Self-hosted sqld: use the http(s):// URL directly.
TURSO_DATABASE_URL=libsql://your-db-orgname.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ── Voyage AI (embeddings) ─────────────────────────────────────────────────────
# https://www.voyageai.com — used at seed time and query time for RAG.
VOYAGE_API_KEY=pa-...
